#!/usr/bin/env python3
"""Run desktop helpers, and stop them when Niri's IPC connection closes."""
import fcntl
import os
from pathlib import Path
import signal
import shutil
import subprocess
import sys
import time

runtime = Path(os.environ['XDG_RUNTIME_DIR'])
lock = (runtime / 'niri-dotfiles-session.lock').open('w')
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    lock.close()
    raise SystemExit(0)

config = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config')))
commands = [
    ['swayidle', '-w', 'timeout', '300', 'swaylock -f',
     'timeout', '600', 'niri msg action power-off-monitors',
     'resume', 'niri msg action power-on-monitors',
     'before-sleep', 'swaylock -f'],
]
children = []
stopping = False


def stop(*_):
    global stopping
    stopping = True


signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
shell = None
try:
    monitor = subprocess.Popen(['niri', 'msg', 'event-stream'], stdout=subprocess.DEVNULL)
    children.append(monitor)
    for command in commands:
        children.append(subprocess.Popen(command))
    agent = shutil.which('polkit-kde-authentication-agent-1', path='/usr/lib')
    if agent:
        children.append(subprocess.Popen([agent]))
    else:
        print('Install polkit-kde-agent for authentication dialogs.', file=sys.stderr)
    if shutil.which('qs'):
        shell = subprocess.Popen(
            ['qs', '--path', str(config / 'quickshell/desktop'), '--no-duplicate'],
            start_new_session=True,
        )
        children.append(shell)
    else:
        print('Quickshell is not installed; install quickshell for the desktop bar.', file=sys.stderr)
    while not stopping and monitor.poll() is None:
        if shell is not None and shell.poll() is not None:
            # Keep idle locking active even if the desktop shell exits.
            print(f'Quickshell exited with status {shell.returncode}.', file=sys.stderr)
            try:
                os.killpg(shell.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            shell = None
        for child in children:
            child.poll()  # Reap exited children.
        time.sleep(1)
finally:
    if shell is not None:
        try:
            os.killpg(shell.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    for child in children:
        if child.poll() is None:
            child.terminate()
    for child in children:
        try:
            child.wait(timeout=3)
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait()
    if shell is not None:
        try:
            os.killpg(shell.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    lock.close()
